MYSQL_DATABASE=turnera
MYSQL_USER=turnera_app
MYSQL_PASSWORD=turnera_dev_password
MYSQL_ROOT_PASSWORD=turnera_root_dev_password
MYSQL_PORT=3306
BACKEND_PORT=8080
JPA_DDL_AUTO=update

# Bootstrap opcional del primer administrador. Activar solo durante el primer arranque.
TURNERA_BOOTSTRAP_ADMIN_ENABLED=false
TURNERA_BOOTSTRAP_ADMIN_DNI=
TURNERA_BOOTSTRAP_ADMIN_NOMBRE=
TURNERA_BOOTSTRAP_ADMIN_APELLIDO=
TURNERA_BOOTSTRAP_ADMIN_EMAIL=
TURNERA_BOOTSTRAP_ADMIN_PASSWORD=
# Generar un secreto propio de al menos 32 bytes y codificarlo en Base64.
JWT_SECRET=
JWT_EXPIRATION=3600000
